@model SolicitudFiltroViewModel
@{
    ViewData["Title"] = "Mis solicitudes";
}

<h1>Mis solicitudes</h1>

@if (Model.HayErrores)
{
    <div class="alert alert-danger" role="alert" id="alerta-filtros">
        <strong>No se pudo aplicar el filtro:</strong>
        <ul class="mb-0">
            @foreach (var error in Model.Errores)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<form asp-action="Index" method="get" class="border rounded p-3 mb-4 bg-light">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label asp-for="Estado" class="form-label">Estado</label>
            <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoSolicitud>()">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="MontoMin" class="form-label">Monto mínimo</label>
            <input asp-for="MontoMin" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-2">
            <label asp-for="MontoMax" class="form-label">Monto máximo</label>
            <input asp-for="MontoMax" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-2">
            <label asp-for="FechaDesde" class="form-label">Fecha inicio</label>
            <input asp-for="FechaDesde" class="form-control" type="date" />
        </div>
        <div class="col-md-2">
            <label asp-for="FechaHasta" class="form-label">Fecha fin</label>
            <input asp-for="FechaHasta" class="form-control" type="date" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
        </div>
    </div>
    <div class="mt-2">
        <a asp-action="Index" class="link-secondary">Limpiar filtros</a>
    </div>
</form>

@if (!Model.HayErrores)
{
    @if (Model.Resultados.Count == 0)
    {
        <div class="alert alert-secondary">No hay solicitudes que coincidan con los filtros.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Monto solicitado</th>
                    <th>Ingresos mensuales</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Resultados)
                {
                    <tr data-solicitud-id="@item.Id">
                        <td>@item.Id</td>
                        <td>@item.FechaSolicitud.ToString("yyyy-MM-dd")</td>
                        <td>@item.MontoSolicitado.ToString("N2")</td>
                        <td>@item.Cliente.IngresosMensuales.ToString("N2")</td>
                        <td class="celda-estado"><partial name="_EstadoSolicitud" model="item.Estado" /></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
