@model IEnumerable<SolicitudCredito>
@{
    ViewData["Title"] = "Panel del Analista";
}

<h1>Panel del Analista</h1>
<p class="text-muted">Solicitudes en estado <strong>Pendiente</strong> pendientes de evaluación.</p>

@if (TempData["MensajeExito"] is string exito)
{
    <div class="alert alert-success" role="alert" id="mensaje-exito">@exito</div>
}
@if (TempData["MensajeError"] is string error)
{
    <div class="alert alert-danger" role="alert" id="mensaje-error">@error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">No hay solicitudes pendientes.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Usuario</th>
                <th>Fecha</th>
                <th>Monto</th>
                <th>Ingresos</th>
                <th>Regla 5x</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-solicitud-id="@item.Id">
                    <td>@item.Id</td>
                    <td>@item.Cliente.Id</td>
                    <td>@(item.Cliente.Usuario?.Email ?? "-")</td>
                    <td>@item.FechaSolicitud.ToString("yyyy-MM-dd")</td>
                    <td>@item.MontoSolicitado.ToString("N2")</td>
                    <td>@item.Cliente.IngresosMensuales.ToString("N2")</td>
                    <td>
                        @if (item.MontoSolicitado <= item.Cliente.IngresosMensuales * 5)
                        {
                            <span class="badge bg-success">≤ 5x</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">&gt; 5x</span>
                        }
                    </td>
                    <td class="text-end">
                        <form asp-action="Aprobar" asp-route-id="@item.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                        </form>
                        <a asp-action="Rechazar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Rechazar</a>
                        <a asp-controller="Solicitudes" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
